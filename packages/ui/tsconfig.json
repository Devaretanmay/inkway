{
  "extends": "@inkway/tsconfig/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/lib/utils": ["./lib/utils.ts"],
      "@/hooks/*": ["./hooks/*"],
      "@/components/ui/*": ["./components/ui/*"],
      "@inkway/ui/components": ["./components"],
      "@inkway/ui/lib": ["./lib"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
